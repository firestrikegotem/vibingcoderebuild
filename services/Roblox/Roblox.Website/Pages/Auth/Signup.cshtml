@page "/auth/signup"
@model Roblox.Website.Pages.Auth.Signup

@{
    Layout = "Shared/_Layout";
    var currentYear = DateTime.UtcNow.Year;
}
<partial name="_SignupStyles" />

<div class="auths-wrap">
    <partial name="_BloxynLogo" model='"bloxyn-logo-hero"' />

    <div class="auths-card">
        <h1 class="auths-title">Sign up and start having fun!</h1>

        @if (Model.invite != null)
        {
            <p class="auths-note">
                You have been invited to this website by <strong>@Model.inviterUsername</strong>. To sign up, just fill in the form below.
            </p>
            <p class="auths-warn">
                <strong>Important password notice:</strong> you cannot recover your password if you forget it. Use a password manager such as
                <a href="https://1password.com/" rel="nofollow noopener noreferrer" target="_blank">1Password</a> or
                <a href="https://bitwarden.com/" rel="nofollow noopener noreferrer" target="_blank">Bitwarden</a>.
            </p>
        }

        @if (Model.discordVerification != null)
        {
            <div class="auths-discord auths-discord--ok">
                <span class="auths-discord-badge">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                </span>
                <span>Discord linked as <strong>@Model.discordVerification.username</strong></span>
            </div>
        }
        else if (Model.discordRequired)
        {
            <div class="auths-discord">
                <span class="auths-discord-title">Step 1: link your Discord</span>
                <p class="auths-discord-text">
                    Bloxyn is a Discord community first. Join our server, then connect your Discord account to unlock signup.
                </p>
                <div class="auths-discord-actions">
                    <a class="auths-discord-btn" href="@Model.discordInviteUrl" target="_blank" rel="noopener noreferrer">Join the server</a>
                    <a class="auths-discord-btn auths-discord-btn--primary" href="@Model.discordOAuthUrl">Connect Discord</a>
                </div>
            </div>
        }

        @if (Model.errorMessage != null)
        {
            <p class="auths-error">@Model.errorMessage</p>
        }

        <form method="post">
            <div class="auths-field">
                <label class="auths-label" for="signup-birth-month">Birthday</label>
                <div class="auths-birthday">
                    <select id="signup-birth-month" name="birthMonth" class="auths-select auths-birthday-month" disabled="@(Model.signupDisabled || Model.discordRequired)">
                        <option value="" selected="@(Model.birthMonth == null)">Month</option>
                        @for (var month = 1; month <= 12; month++)
                        {
                            <option value="@month" selected="@(Model.birthMonth == month)">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)</option>
                        }
                    </select>
                    <select id="signup-birth-day" name="birthDay" class="auths-select auths-birthday-day" disabled="@(Model.signupDisabled || Model.discordRequired)">
                        <option value="" selected="@(Model.birthDay == null)">Day</option>
                        @for (var day = 1; day <= 31; day++)
                        {
                            <option value="@day" selected="@(Model.birthDay == day)">@day</option>
                        }
                    </select>
                    <select id="signup-birth-year" name="birthYear" class="auths-select auths-birthday-year" disabled="@(Model.signupDisabled || Model.discordRequired)">
                        <option value="" selected="@(Model.birthYear == null)">Year</option>
                        @for (var year = currentYear; year >= 1900; year--)
                        {
                            <option value="@year" selected="@(Model.birthYear == year)">@year</option>
                        }
                    </select>
                </div>
            </div>

            <div class="auths-field">
                <label class="auths-label" for="signup-username">Username</label>
                <input id="signup-username" disabled="@(Model.signupDisabled || Model.discordRequired)" type="text" placeholder="Don't use your real name" name="username" value="@Model.username" class="auths-input" autocomplete="username" />
            </div>

            <div class="auths-field">
                <label class="auths-label" for="signup-password">Password</label>
                <input id="signup-password" disabled="@(Model.signupDisabled || Model.discordRequired)" type="password" placeholder="At least 8 characters" name="password" class="auths-input" autocomplete="new-password" />
            </div>

            <div class="auths-field">
                <span class="auths-label">Gender <span class="auths-optional">(optional)</span></span>
                <div class="auths-gender">
                    <label class="auths-gender-opt">
                        <input disabled="@(Model.signupDisabled || Model.discordRequired)" type="radio" name="gender" value="male" checked="@(Model.gender == "male")" />
                        <span class="auths-gender-seg" title="Male">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="10" cy="14" r="5.2"></circle>
                                <path d="M13.9 10.1 20 4"></path>
                                <path d="M15 4h5v5"></path>
                            </svg>
                            <span class="visually-hidden">Male</span>
                        </span>
                    </label>
                    <label class="auths-gender-opt">
                        <input disabled="@(Model.signupDisabled || Model.discordRequired)" type="radio" name="gender" value="female" checked="@(Model.gender == "female")" />
                        <span class="auths-gender-seg" title="Female">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="9" r="5.2"></circle>
                                <path d="M12 14.2V21"></path>
                                <path d="M9 18.4h6"></path>
                            </svg>
                            <span class="visually-hidden">Female</span>
                        </span>
                    </label>
                </div>
            </div>

            <p class="auths-terms">
                By clicking Sign Up, you are agreeing to the <a href="/auth/tos">Terms of Use</a> including the arbitration clause and you are acknowledging the
                <a href="/auth/privacy">Privacy Policy</a>.
            </p>

            @Html.AntiForgeryToken()
            <button disabled="@(Model.signupDisabled || Model.discordRequired)" class="auths-submit" type="submit" id="signup-submit">Sign Up</button>
        </form>
    </div>

    @if (Model.applicationId != null && Model.invite == null)
    {
        <p class="auths-switch">
            Already have an account you'd like to reactivate? <a href="/auth/login?applicationId=@Model.applicationId">Log in here</a>.
        </p>
    }
    else
    {
        <p class="auths-switch">
            Already have an account? <a href="/auth/login">Log in here</a>.
        </p>
    }
</div>

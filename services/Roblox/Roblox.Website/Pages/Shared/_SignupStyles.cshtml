<style>
    /* 2016 sign up screen: wordmark + light grey card over the park wallpaper */
    .auths-wrap {
        min-height: calc(100vh - 168px);
        padding: 34px 16px 48px;
        display: flex;
        flex-direction: column;
        align-items: center;
        background-color: #76c7f4;
        background-image:
            linear-gradient(180deg, rgba(9, 45, 64, .22), rgba(9, 45, 64, .08) 42%, rgba(9, 45, 64, .26)),
            url("data:image/webp;base64,");
        background-size: cover, cover;
        background-position: center center;
        background-repeat: no-repeat;
    }


    /* Login page wallpaper (separate shot from the signup page) */
    .auths-wrap-login {
        background-color: #63c5f4;
        background-image:
            linear-gradient(180deg, rgba(9, 45, 64, .22), rgba(9, 45, 64, .08) 42%, rgba(9, 45, 64, .26)),
            url("data:image/webp;base64,");
        background-size: cover, cover;
        background-position: center center, center center;
        background-repeat: no-repeat, no-repeat;
    }

    .auths-card {
        width: 100%;
        max-width: 520px;
        padding: 26px 30px 24px;
        background: #eaeaea;
        border: 1px solid #dadada;
        border-radius: 5px;
        box-shadow: 0 14px 34px rgba(8, 44, 58, .28);
    }

    .auths-title {
        margin: 0 0 20px;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: .2px;
        line-height: 1.25;
        text-align: center;
        text-transform: uppercase;
        color: #333;
    }

    .auths-field {
        margin-bottom: 14px;
    }

    .auths-label {
        display: block;
        margin-bottom: 5px;
        font-size: 12.5px;
        font-weight: 700;
        color: #3a3a3a;
    }

    .auths-optional {
        font-weight: 400;
        color: #7d7d7d;
    }

    .auths-input,
    .auths-select {
        width: 100%;
        height: 40px;
        padding: 0 11px;
        font-size: 14px;
        font-family: inherit;
        color: #303030;
        background-color: #fff;
        border: 1px solid #c4c4c4;
        border-radius: 3px;
        transition: border-color .15s, box-shadow .15s;
    }

    .auths-input::placeholder {
        color: #a0a0a0;
    }

    .auths-input:focus,
    .auths-select:focus {
        outline: none;
        border-color: #3a9fd6;
        box-shadow: 0 0 0 3px rgba(58, 159, 214, .18);
    }

    .auths-input:disabled,
    .auths-select:disabled {
        background-color: #f2f2f2;
        color: #9a9a9a;
    }

    .auths-select {
        appearance: none;
        -webkit-appearance: none;
        padding-right: 28px;
        cursor: pointer;
        background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'%3E%3Cpath d='M1 1l4 4 4-4' fill='none' stroke='%23777' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 10px center;
    }

    .auths-select:invalid,
    .auths-select.is-placeholder {
        color: #a0a0a0;
    }

    .auths-birthday {
        display: flex;
        gap: 8px;
    }

    .auths-birthday-month {
        flex: 1.35;
    }

    .auths-birthday-day {
        flex: .85;
    }

    .auths-birthday-year {
        flex: 1.15;
    }

    .auths-gender {
        display: flex;
        background: #fff;
        border: 1px solid #c4c4c4;
        border-radius: 3px;
        overflow: hidden;
    }

    .auths-gender-opt {
        position: relative;
        display: block;
        flex: 1;
        margin: 0;
    }

    .auths-gender-opt + .auths-gender-opt {
        border-left: 1px solid #dcdcdc;
    }

    .auths-gender-opt input {
        position: absolute;
        opacity: 0;
        width: 1px;
        height: 1px;
    }

    .auths-gender-seg {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 44px;
        color: #8d8d8d;
        cursor: pointer;
        transition: background .12s, color .12s, box-shadow .12s;
    }

    .auths-gender-seg:hover {
        background: #f7f7f7;
        color: #5f5f5f;
    }

    .auths-gender-opt input:checked + .auths-gender-seg {
        color: #1b7fb4;
        background: #e9f5fc;
        box-shadow: inset 0 0 0 2px #3a9fd6;
    }

    .auths-gender-opt input:focus-visible + .auths-gender-seg {
        outline: 2px solid #3a9fd6;
        outline-offset: -3px;
    }

    .auths-terms {
        margin: 14px 0 16px;
        font-size: 11.5px;
        line-height: 1.6;
        color: #5c5c5c;
    }

    .auths-terms a {
        color: #2f7fd1;
        text-decoration: none;
    }

    .auths-terms a:hover {
        text-decoration: underline;
    }

    .auths-forgot {
        margin: 2px 0 14px;
        font-size: 12.5px;
    }

    .auths-forgot a {
        color: #2f7fd1;
        text-decoration: none;
    }

    .auths-forgot a:hover {
        text-decoration: underline;
    }

    .auths-submit {
        display: block;
        width: 100%;
        height: 44px;
        font-size: 15.5px;
        font-weight: 700;
        color: #fff;
        background: #757575;
        border: 1px solid #6a6a6a;
        border-radius: 999px;
        cursor: pointer;
        transition: background .12s;
    }

    .auths-submit:hover {
        background: #666;
    }

    .auths-submit:active {
        background: #5c5c5c;
    }

    .auths-submit:disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .auths-note {
        margin: 0 0 14px;
        padding: 10px 12px;
        font-size: 12.5px;
        line-height: 1.55;
        color: #38505d;
        background: #f2f9fd;
        border: 1px solid #cfe4f1;
        border-left: 3px solid #3aa9e0;
        border-radius: 3px;
    }

    .auths-warn {
        margin: 0 0 14px;
        padding: 10px 12px;
        font-size: 12.5px;
        line-height: 1.55;
        color: #6b5300;
        background: #fffaeb;
        border: 1px solid #f0d9a0;
        border-left: 3px solid #e0a800;
        border-radius: 3px;
    }

    .auths-error {
        margin: 0 0 14px;
        padding: 10px 12px;
        font-size: 12.5px;
        line-height: 1.55;
        color: #8c1f16;
        background: #fdf3f2;
        border: 1px solid #f2c2c0;
        border-left: 3px solid #d93025;
        border-radius: 3px;
    }

    .auths-note a,
    .auths-warn a {
        color: #1b96d6;
        font-weight: 600;
        text-decoration: none;
    }

    .auths-note a:hover,
    .auths-warn a:hover {
        text-decoration: underline;
    }

    .auths-switch {
        margin: 16px 0 0;
        font-size: 13px;
        text-align: center;
        color: #eaf7ff;
        text-shadow: 0 1px 3px rgba(0, 0, 0, .45);
    }

    .auths-switch a {
        color: #fff;
        font-weight: 700;
        text-decoration: underline;
    }

    @@media (max-width: 575px) {
        .auths-wrap {
            padding: 20px 12px 32px;
            min-height: calc(100vh - 150px);
        }


        .auths-card {
            padding: 22px 18px 20px;
        }

        .auths-title {
            font-size: 17px;
            margin-bottom: 16px;
        }

        .auths-birthday {
            gap: 6px;
        }
    }
</style>

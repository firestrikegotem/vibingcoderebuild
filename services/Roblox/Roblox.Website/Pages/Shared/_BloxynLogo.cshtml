@model object?
@{
    // Callers pass an extra class name, e.g. model='"bloxyn-logo-hero"'. Anything else
    // (including the page model, when rendered straight from the layout) means no extra class.
    var extraClass = Model is string cls && !string.IsNullOrWhiteSpace(cls) ? " " + cls : string.Empty;
}
<img class="bloxyn-logo@(extraClass)" src="data:image/png;base64," alt="Bloxyn" />
